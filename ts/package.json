{
  "name": "switchboard",
  "version": "0.1.0",
  "description": "An agentic runtime that discovers and orchestrates tools across multiple MCP servers to execute multi-step tasks (TypeScript port).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "switchboard": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "server:deployment": "tsx servers/deployment-server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

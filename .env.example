# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for planning / tool-selection / synthesis
ORCHESTRATOR_MODEL=claude-sonnet-5

# Optional: GitHub MCP server token (only if you enable the github server in config/servers.yaml)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: Postgres MCP connection string (only if you enable the postgres server)
DATABASE_URL=postgresql://localhost:5432/postgres
